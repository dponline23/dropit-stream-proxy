# Source XML. Keep the DropIT token here, not in source code.
SOURCE_XML_URL=http://example.com/price.xml?dropid=REPLACE_ME

# n8n PRODUCTION webhook that receives one lightweight RU batch per request.
N8N_WEBHOOK_URL=https://YOUR-N8N/webhook/dropit-ru-batch

# Number of offers per POST to n8n. Start with 50 on the n8n trial.
BATCH_SIZE=50

# Protect POST /sync and GET /status.
SYNC_TOKEN=replace-with-a-long-random-string

# Optional authentication header sent to the n8n webhook.
# Leave both blank if the n8n webhook has no Header Auth during the first test.
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=

# Railway/Render sets PORT automatically.
PORT=3000
